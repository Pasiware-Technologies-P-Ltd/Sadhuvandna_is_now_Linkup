{
  "expo": {
    "name": "Linkup",
    "slug": "sadhu-vandna",
    "version": "1.64.0",
    "scheme": "sadhuvandna",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#2563EB"
      },
      "versionCode": 64,
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.sadhuvandna.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.sadhuvandna.co.in",
              "pathPrefix": "/view_post.php"
            },
            {
              "scheme": "https",
              "host": "www.sadhuvandna.co.in",
              "pathPrefix": "/view_news.php"
            },
            {
              "scheme": "https",
              "host": "sadhuvandna.co.in",
              "pathPrefix": "/view_post.php"
            },
            {
              "scheme": "https",
              "host": "sadhuvandna.co.in",
              "pathPrefix": "/view_news.php"
            },
            {
              "scheme": "https",
              "host": "sadhuvandna.co.in",
              "pathPrefix": "/Api/join_group.php"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "sadhuvandna"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3506685647762869~7657403518",
          "iosAppId": "ca-app-pub-3506685647762869~0000000000"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to make video calls.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to make audio and video calls.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "92d63729-90e7-4330-b21a-eedc6fd74c7c"
      }
    }
  }
}
