RewriteEngine On

# 1. Remove .php extension from URL (External 301 Redirect) with Query String Preserved
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE,QSA]

# 2. Serve .php file internally when requested without extension, preserving query string
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

php_value upload_max_filesize 2048M
php_value post_max_size 2050M
php_value max_execution_time 3000
php_value max_input_time 3000